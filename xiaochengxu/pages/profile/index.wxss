.page {
  padding-bottom: 60rpx;
}

/* 会员头卡 */
.head-card {
  margin: 24rpx;
  padding: 44rpx 36rpx;
  background: var(--ink);
  border-radius: 16rpx;
}
.head-eyebrow {
  font-size: 20rpx;
  letter-spacing: 8rpx;
  text-transform: uppercase;
  color: var(--gold);
}
.head-tag {
  margin-top: 24rpx;
  display: inline-block;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--gold);
  border: 1rpx solid rgba(179, 155, 107, 0.5);
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
}
.head-name {
  margin-top: 16rpx;
  color: var(--ivory);
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.head-email {
  margin-top: 8rpx;
  color: rgba(251, 249, 244, 0.55);
  font-size: 24rpx;
}
.head-btns {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}
.head-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: var(--ivory);
  border: 1rpx solid rgba(251, 249, 244, 0.4);
}
.head-btn-main {
  background: var(--gold-deep);
  border-color: var(--gold-deep);
  color: #fff;
}

/* 菜单 */
.menu {
  margin: 0 24rpx;
}
.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
  font-size: 28rpx;
}
.menu-row:last-child {
  border-bottom: none;
}
.menu-arrow {
  color: var(--muted);
  font-size: 30rpx;
}
.menu-logout {
  justify-content: center;
  color: #b0524a;
}
