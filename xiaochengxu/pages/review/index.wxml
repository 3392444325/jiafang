<view class="page">
  <view class="form card">
    <view wx:if="{{productName}}" class="rev-target">评价商品：{{productName}}</view>

    <view class="form-item">
      <text class="form-label">评分</text>
      <view class="stars">
        <text
          wx:for="{{stars}}"
          wx:key="*this"
          class="star {{item <= rating ? 'star-on' : ''}}"
          data-v="{{item}}"
          bindtap="pickStar"
        >★</text>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">评价内容</text>
      <textarea
        class="field rev-textarea"
        maxlength="500"
        placeholder="说说你的睡眠体验…"
        placeholder-class="ph"
        value="{{content}}"
        bindinput="onInput"
      />
    </view>

    <view class="btn-primary {{busy ? 'disabled' : ''}}" bindtap="submit">
      {{busy ? '提交中…' : '发表评价'}}
    </view>
  </view>

  <view class="foot-hint">评价通过后将在商品详情页展示</view>
</view>
