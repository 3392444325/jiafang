.page {
  padding-bottom: 60rpx;
}

/* 表单 */
.form {
  margin: 24rpx;
  padding: 36rpx 28rpx;
}
.form-item {
  margin-bottom: 28rpx;
}
.ph {
  color: var(--muted);
}
.rev-target {
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--line);
  font-size: 26rpx;
  color: var(--ink-soft);
}
.stars {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}
.star {
  font-size: 56rpx;
  line-height: 1;
  color: #d5d0c6;
}
.star-on {
  color: var(--gold);
}
.rev-textarea {
  width: 100%;
  height: 280rpx;
}
.foot-hint {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}
