<view class="page">
  <!-- 品牌头部 -->
  <view class="brand-head">
    <text class="brand-eyebrow">ST.KELLY</text>
    <view class="brand-title">加入ST.KELLY</view>
    <view class="brand-line"></view>
  </view>

  <!-- 注册表单 -->
  <view class="form card">
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input
        class="field"
        type="text"
        placeholder="怎么称呼您"
        placeholder-class="ph"
        value="{{name}}"
        data-k="name"
        bindinput="onInput"
      />
    </view>
    <view class="form-item">
      <text class="form-label">邮箱</text>
      <input
        class="field"
        type="text"
        placeholder="官网注册的邮箱账号"
        placeholder-class="ph"
        value="{{email}}"
        data-k="email"
        bindinput="onInput"
      />
    </view>
    <view class="form-item">
      <text class="form-label">密码（至少 6 位）</text>
      <input
        class="field"
        password
        placeholder="请设置密码"
        placeholder-class="ph"
        value="{{password}}"
        data-k="password"
        bindinput="onInput"
      />
    </view>
    <view class="btn-primary {{busy ? 'disabled' : ''}}" bindtap="submit">
      {{busy ? '注册中…' : '注　册'}}
    </view>
    <view class="swap" bindtap="goLogin">已有账号？去登录 ›</view>
  </view>
</view>
