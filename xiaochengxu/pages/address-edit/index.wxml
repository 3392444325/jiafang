<view class="page">
  <view class="form card">
    <view class="form-item">
      <text class="form-label">联系人</text>
      <input
        class="field"
        placeholder="收货人姓名"
        placeholder-class="ph"
        value="{{name}}"
        data-k="name"
        bindinput="onInput"
      />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="field"
        type="number"
        maxlength="11"
        placeholder="11 位手机号"
        placeholder-class="ph"
        value="{{phone}}"
        data-k="phone"
        bindinput="onInput"
      />
    </view>
    <view class="form-row">
      <view class="form-item form-col">
        <text class="form-label">省份</text>
        <input
          class="field"
          placeholder="如 浙江省"
          placeholder-class="ph"
          value="{{province}}"
          data-k="province"
          bindinput="onInput"
        />
      </view>
      <view class="form-item form-col">
        <text class="form-label">城市</text>
        <input
          class="field"
          placeholder="如 杭州市"
          placeholder-class="ph"
          value="{{city}}"
          data-k="city"
          bindinput="onInput"
        />
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">区 / 县（选填）</text>
      <input
        class="field"
        placeholder="如 拱墅区"
        placeholder-class="ph"
        value="{{district}}"
        data-k="district"
        bindinput="onInput"
      />
    </view>
    <view class="form-item">
      <text class="form-label">详细地址</text>
      <textarea
        class="field addr-textarea"
        maxlength="200"
        placeholder="街道、门牌号、小区等"
        placeholder-class="ph"
        value="{{detail}}"
        data-k="detail"
        bindinput="onInput"
      />
    </view>
    <view wx:if="{{!isEdit}}" class="form-item default-row">
      <text class="form-label">设为默认地址</text>
      <switch checked="{{isDefault}}" color="#b39b6b" bindchange="onDefaultChange" />
    </view>
    <view class="btn-primary {{saving ? 'disabled' : ''}}" bindtap="save">
      {{saving ? '保存中…' : '保　存'}}
    </view>
  </view>
</view>
