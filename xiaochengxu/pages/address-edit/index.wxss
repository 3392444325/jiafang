.page {
  padding-bottom: 60rpx;
}

/* 表单 */
.form {
  margin: 24rpx;
  padding: 36rpx 28rpx;
}
.form-item {
  margin-bottom: 28rpx;
}
.form-row {
  display: flex;
  gap: 20rpx;
}
.form-col {
  flex: 1;
}
.addr-textarea {
  width: 100%;
  height: 160rpx;
}
.default-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.default-row .form-label {
  margin-bottom: 0;
}
.ph {
  color: var(--muted);
}
