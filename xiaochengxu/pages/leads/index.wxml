<view class="page">
  <!-- 品牌语 -->
  <view class="lead-head">
    <text class="eyebrow">Business</text>
    <view class="lead-slogan">把『睡个好觉』的生意/体验，带给更多人。</view>
  </view>

  <!-- 类型选择 -->
  <view
    wx:for="{{types}}"
    wx:key="key"
    class="type-card {{type === item.key ? 'type-on' : ''}}"
    data-key="{{item.key}}"
    bindtap="pickType"
  >
    <view class="type-name">{{item.label}}</view>
    <view class="type-desc">{{item.desc}}</view>
  </view>

  <!-- 登记表单 -->
  <view class="form card">
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input
        class="field"
        placeholder="请输入您的姓名"
        placeholder-class="ph"
        value="{{name}}"
        data-k="name"
        bindinput="onInput"
      />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="field"
        type="number"
        maxlength="11"
        placeholder="11 位手机号"
        placeholder-class="ph"
        value="{{phone}}"
        data-k="phone"
        bindinput="onInput"
      />
    </view>
    <view class="form-item">
      <text class="form-label">留言（选填）</text>
      <textarea
        class="field lead-note"
        maxlength="300"
        placeholder="说说您的需求或想法…"
        placeholder-class="ph"
        value="{{note}}"
        data-k="note"
        bindinput="onInput"
      />
    </view>
    <view class="btn-primary {{busy ? 'disabled' : ''}}" bindtap="submit">
      {{busy ? '提交中…' : '提交登记'}}
    </view>
  </view>
</view>
