.page {
  padding-bottom: 80rpx;
}

/* 品牌头部 */
.brand-head {
  background: var(--ink);
  padding: 64rpx 48rpx 56rpx;
}
.brand-eyebrow {
  font-size: 20rpx;
  letter-spacing: 8rpx;
  text-transform: uppercase;
  color: var(--gold);
}
.brand-title {
  margin-top: 20rpx;
  color: var(--ivory);
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
}
.brand-line {
  margin-top: 28rpx;
  width: 72rpx;
  height: 4rpx;
  background: var(--gold);
}

/* 表单 */
.form {
  margin: 32rpx 24rpx 0;
  padding: 36rpx 28rpx 32rpx;
}
.form-item {
  margin-bottom: 28rpx;
}
.ph {
  color: var(--muted);
}
.swap {
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--gold-deep);
}
.hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}
