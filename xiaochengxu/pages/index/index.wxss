.page {
  padding-bottom: 40rpx;
}

/* 搜索栏（吸顶） */
.search-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: #1c1b19;
  padding: 16rpx 24rpx;
}
.search-inner {
  background: rgba(251, 249, 244, 0.14);
  border: 1rpx solid rgba(251, 249, 244, 0.2);
  border-radius: 999rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}
.search-txt {
  color: rgba(251, 249, 244, 0.55);
  font-size: 26rpx;
}

/* Banner */
.banner {
  height: 400rpx;
}
.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}
.banner-img {
  width: 100%;
  height: 100%;
}
.banner-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(28, 27, 25, 0.45), rgba(28, 27, 25, 0.05));
}
.banner-title {
  position: absolute;
  left: 32rpx;
  bottom: 40rpx;
  color: #fbf9f4;
  font-size: 30rpx;
  letter-spacing: 4rpx;
}

/* 区块 */
.sec {
  margin-top: 40rpx;
  padding: 0 24rpx;
}
.sec-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}
.sec-head-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.sec-more {
  font-size: 24rpx;
  color: var(--muted);
}
.sec-title {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: var(--ink);
}

/* 分类横滑 */
.cat-scroll {
  white-space: nowrap;
}
.cat-item {
  display: inline-block;
  width: 150rpx;
  margin-right: 20rpx;
  text-align: center;
}
.cat-hover {
  opacity: 0.75;
}
.cat-img-wrap {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--sand);
}
.cat-img {
  width: 100%;
  height: 100%;
}
.cat-name {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
}

/* 两列网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.grid-item {
  width: calc(50% - 10rpx);
}

/* 页脚 */
.brand-foot {
  margin-top: 60rpx;
  text-align: center;
  padding: 40rpx 0 20rpx;
}
.brand-foot-cn {
  font-size: 22rpx;
  letter-spacing: 8rpx;
  color: rgba(28, 27, 25, 0.3);
}
