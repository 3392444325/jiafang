.page {
  padding-bottom: 40rpx;
}

/* 地址卡 */
.addr-card {
  margin: 24rpx;
  padding: 28rpx;
}
.addr-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.addr-name {
  font-size: 30rpx;
  font-weight: 600;
}
.addr-phone {
  font-size: 26rpx;
  color: var(--ink-soft);
}
.addr-badge {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--gold-deep);
  border: 1rpx solid var(--gold-deep);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
}
.addr-detail {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.6;
}
.addr-ops {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  display: flex;
  justify-content: flex-end;
  gap: 40rpx;
}
.op {
  font-size: 24rpx;
  color: var(--ink-soft);
}
.op-danger {
  color: #b0524a;
}

.page-foot-space {
  height: 160rpx;
}

/* 底部新增按钮 */
.bar-add {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: var(--ink);
  color: var(--ivory);
  border-radius: 999rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}
